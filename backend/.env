PORT=5000
NODE_ENV=development
DATABASE_URL=./database/payroll.db

# JWT
JWT_SECRET=your-jwt-secret-key-dev-mode-12345
JWT_EXPIRE=24h

# Session
SESSION_SECRET=your-session-secret-key-dev-mode

# Google OAuth
GOOGLE_CLIENT_ID=demo-google-client-id
GOOGLE_CLIENT_SECRET=demo-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Microsoft OAuth
MICROSOFT_CLIENT_ID=demo-microsoft-client-id
MICROSOFT_CLIENT_SECRET=demo-microsoft-client-secret
MICROSOFT_CALLBACK_URL=http://localhost:5000/api/auth/microsoft/callback

# Encryption
ENCRYPTION_KEY=12345678901234567890123456789012
ENCRYPTION_IV=1234567890123456

# Email (for future use)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=demo@gmail.com
SMTP_PASSWORD=demo-password
